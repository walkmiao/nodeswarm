# Controller must use HTTPS outside local loopback.
NODE_MANAGER_CONTROLLER=https://console.example.com
NODE_MANAGER_ENROLL_KEY=
NODE_MANAGER_AGENT_NAME=Gaming-Desktop-01
# observe: only reports process instances and configured routing strategy.
# proxybridge: routes entire executable names through an installed CLI.
# This CANNOT isolate same-name PIDs to distinct proxies.
NODE_MANAGER_CLIENT_ENGINE=observe
NODE_MANAGER_CLIENT_TARGETS=Client.exe
# Required only for proxybridge mode. Install it from the upstream publisher.
NODE_MANAGER_PROXYBRIDGE_CLI=

# Optional hard limit on this Windows workstation (1-128).
# If omitted, follow Controller's per-machine PID quota (default 8).
# Example: prevent more than four PID bindings from activating locally:
# NODE_MANAGER_CLIENT_PID_HARD_LIMIT=4
